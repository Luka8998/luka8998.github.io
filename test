<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Analytics Test Site</title>

<!-- ===== ANALYTICS SNIPPET: paste yours here =====
     Example for Google Analytics 4 — replace G-XXXXXXXXXX with your Measurement ID. -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-XXXXXXXXXX');
</script>
<!-- ============================================== -->

<style>
  :root { --bg:#f7f7f8; --fg:#1a1a1a; --card:#fff; --accent:#4f46e5; --muted:#666; }
  @media (prefers-color-scheme: dark) { :root { --bg:#111; --fg:#eee; --card:#1c1c1e; --muted:#aaa; } }
  * { box-sizing: border-box; }
  body { margin:0; font-family: system-ui, sans-serif; background:var(--bg); color:var(--fg); line-height:1.5; }
  nav { display:flex; gap:16px; padding:16px; background:var(--card); position:sticky; top:0; border-bottom:1px solid #8883; }
  nav a { color:var(--accent); text-decoration:none; font-weight:600; }
  main { max-width:720px; margin:0 auto; padding:16px; }
  section { background:var(--card); border-radius:12px; padding:20px; margin:16px 0; }
  button { background:var(--accent); color:#fff; border:0; padding:10px 16px; border-radius:8px; cursor:pointer; margin:4px 4px 4px 0; font-size:15px; }
  input, select { padding:8px; border-radius:6px; border:1px solid #8886; width:100%; margin:4px 0 12px; font-size:15px; }
  #log { font-family: ui-monospace, monospace; font-size:13px; color:var(--muted); max-height:200px; overflow:auto; white-space:pre-wrap; }
  .spacer { height:900px; display:flex; align-items:flex-end; color:var(--muted); }
</style>
</head>
<body>

<nav>
  <a href="#home">Home</a>
  <a href="#products">Products</a>
  <a href="#signup">Sign up</a>
</nav>

<main>
  <section id="home">
    <h1>Analytics Test Site</h1>
    <p>Click things, fill in the form, scroll down. Each action sends an event (and shows up in the log below).</p>
  </section>

  <section id="products">
    <h2>Products</h2>
    <button data-event="add_to_cart" data-item="Basic Plan">Add Basic ($9)</button>
    <button data-event="add_to_cart" data-item="Pro Plan">Add Pro ($29)</button>
    <button data-event="purchase" data-item="Pro Plan">Buy now</button>
    <p><a href="https://example.com" target="_blank" data-event="outbound_click">Outbound link → example.com</a></p>
    <p><a href="sample.pdf" data-event="file_download">Download sample.pdf</a> (404 is fine)</p>
  </section>

  <section id="signup">
    <h2>Sign up</h2>
    <form id="form">
      <label>Name <input name="name" placeholder="Test User"></label>
      <label>Plan
        <select name="plan"><option>Basic</option><option>Pro</option></select>
      </label>
      <button type="submit">Submit</button>
    </form>
  </section>

  <section>
    <h2>Event log</h2>
    <div id="log">(no events yet)</div>
  </section>

  <div class="spacer">↓ scroll to the bottom to fire a scroll event</div>
  <p id="bottom">You reached the bottom.</p>
</main>

<script>
  const logEl = document.getElementById('log');
  let first = true;

  function track(name, params = {}) {
    if (typeof gtag === 'function') gtag('event', name, params);         // GA4
    if (typeof plausible === 'function') plausible(name, { props: params }); // Plausible
    if (window.umami) umami.track(name, params);                          // Umami
    console.log('[track]', name, params);
    logEl.textContent = (first ? '' : logEl.textContent + '\n') +
      new Date().toLocaleTimeString() + '  ' + name + ' ' + JSON.stringify(params);
    first = false;
  }

  // Buttons & links with data-event
  document.querySelectorAll('[data-event]').forEach(el => {
    el.addEventListener('click', () =>
      track(el.dataset.event, { item: el.dataset.item || el.textContent.trim(), href: el.href || undefined }));
  });

  // Form submit
  document.getElementById('form').addEventListener('submit', e => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(e.target));
    track('sign_up', { plan: d.plan });
    e.target.reset();
  });

  // Hash "page" changes as virtual pageviews
  window.addEventListener('hashchange', () =>
    track('page_view', { page_path: location.pathname + location.hash }));

  // Scroll to bottom (fires once)
  new IntersectionObserver((entries, obs) => {
    if (entries[0].isIntersecting) { track('scroll_bottom'); obs.disconnect(); }
  }).observe(document.getElementById('bottom'));
</script>
</body>
</html>
